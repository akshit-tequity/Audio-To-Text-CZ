# Server
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<dbname>?retryWrites=true&w=majority

# Anthropic (for summaries)
ANTHROPIC_API_KEY=sk-ant-...

# Transcription provider: "whisper" (local, free) or "elevenlabs" (cloud, paid)
TRANSCRIPTION_PROVIDER=whisper

# Whisper
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
# task: "transcribe" = output in spoken language; "translate" = output always in English
WHISPER_TASK=translate
# beam_size: 1=fast/lower quality, 5=default best, 10+=marginal gains for big cost
WHISPER_BEAM_SIZE=5
# initial_prompt: one sentence of context to bias Whisper toward your domain.
# Write in English when WHISPER_TASK=translate; write in the spoken language otherwise.
# Leave empty if you don't want any biasing.
WHISPER_INITIAL_PROMPT=
# hotwords: space-separated proper nouns Whisper should listen for (cities, brand names, station names, IDs).
# Add words only when you see them mistranscribed in your output.
WHISPER_HOTWORDS=

# ElevenLabs (only required when TRANSCRIPTION_PROVIDER=elevenlabs or per-request override)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
# Optional ISO 639-3 hint, e.g. "eng", "hin". Leave blank for auto-detect.
ELEVENLABS_LANGUAGE_CODE=

# Python interpreter (point to your venv python)
PYTHON_BIN=./venv/bin/python

# Batch processing — how often (in rows) to save the Excel file mid-job.
# 1 = save after every row (best for small files / visibility, very small cost).
BATCH_SAVE_EVERY=1
TMP_DIR=./tmp
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=50

# Excel column names (override only if your sheet differs)
COL_RECORDING_URL=EX_RecordingUrls
COL_TRANSCRIPT=EX_Recording_Transcript
COL_SUMMARY=EX_Recording_Summary
